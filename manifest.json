{
  "manifest_version": 3,
  "name": "StartPage",
  "version": "1.1",
  "description": "A clean and customizable new tab page.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "host_permissions": [
    "*://*.qweather.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}