{
  "manifest_version": 3,
  "name": "StartPage",
  "version": "1.9.1",
  "description": "A clean and customizable new tab page.",
  "author": "StartPage contributors",
  "homepage_url": "https://github.com/kabuda2077/StartPage",
  "permissions": [
    "geolocation"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "host_permissions": [
    "https://geoapi.qweather.com/*",
    "https://devapi.qweather.com/*",
    "https://*.qweatherapi.com/*"
  ],
  "icons": {
    "16": "assets/app-icons/icon16.png",
    "48": "assets/app-icons/icon48.png",
    "128": "assets/app-icons/icon128.png"
  }
}
